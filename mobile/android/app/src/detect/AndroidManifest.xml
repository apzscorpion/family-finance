<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            Reads payment alerts already posted by banking and UPI apps.

            This is deliberately used instead of READ_SMS: SMS permissions are
            Restricted Permissions that Google Play grants only to apps whose
            core purpose is messaging, so a finance app requesting them is
            rejected. Notification access carries the same payment details, is
            granted by the user in system settings, and the app stays fully
            usable when it is declined.

            Declaring it also means this build cannot be installed from a
            browser or file manager on current Android: Play Protect blocks
            sideloads that request notification access. Install it over adb, or
            use the standard build and add payments by hand.
        -->
        <service
            android:name=".TxnNotificationListenerService"
            android:exported="false"
            android:label="Detected payments"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
    </application>
</manifest>
