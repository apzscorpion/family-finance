# Shared Family & Personal Finance Manager - Environment Configuration Template

# Application
APP_NAME="Shared Family & Personal Finance Manager"
ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
# JWT Secret Key - MUST be changed in production
SECRET_KEY="replace_with_a_secure_random_64_character_hex_string_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration
# PostgreSQL format: postgresql+psycopg2://user:password@localhost:5432/family_finance
# SQLite format (for development/testing): sqlite:///./family_finance.db
DATABASE_URL="sqlite:///./family_finance.db"

# Organization Constraints
MAX_ORGANIZATION_MEMBERS=30
INVITATION_TOKEN_EXPIRE_HOURS=72

# Android SMS / Notification Security
MAX_SMS_INGESTION_BATCH_SIZE=100
STRICT_LOCAL_SMS_PARSING=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
